// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")    // Only showing error since I am using an older prisma version (6.19.3)
  directUrl= env("DIRECT_URL")      // Only showing error since I am using an older prisma version (6.19.3)
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  passwordHash  String
  createdAt     DateTime @default(now())

  createdGroups     Group[]       @relation("GroupCreator")
  memberships       Membership[]
  expensesPaid      Expense[]     @relation("ExpensePayer")
  splits            ExpenseSplit[]
  sessions          Session[]
  paymentsSent      Payment[]     @relation("PaymentsSent")
  paymentsReceived  Payment[]     @relation("PaymentsReceived")
}

model Group {
  id            String    @id @default(cuid())
  name          String
  createdById   String
  inviteCode    String    @unique @default(cuid())
  createdAt     DateTime  @default(now())

  createdBy     User      @relation("GroupCreator", fields: [createdById], references: [id])
  memberships   Membership[]
  expenses      Expense[]
  payments      Payment[]
}

model Membership {
  id            String    @id @default(cuid())
  userId        String
  groupId       String
  role          String    @default("member")
  joinedAt      DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model Expense {
  id            String    @id @default(cuid())
  groupId       String
  paidById      String
  description   String
  amountCents   Int
  createdAt     DateTime  @default(now())

  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy        User      @relation("ExpensePayer", fields: [paidById], references: [id])
  splits ExpenseSplit[]
}

model ExpenseSplit {
  id            String    @id @default(cuid())
  expenseId     String
  userId        String
  amountCents   Int

  expense       Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String @id @default(cuid())
  groupId     String
  fromUserId  String
  toUserId    String
  amountCents Int
  status      String @default("pending")
  createdAt   DateTime @default(now())

  group       Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser    User    @relation("PaymentsSent", fields: [fromUserId], references: [id])
  toUser      User    @relation("PaymentsReceived", fields: [toUserId], references: [id])
}
